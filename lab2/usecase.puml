@startuml event_system

top to bottom direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

skinparam usecase {
    BackgroundColor #ec9fcd
    BorderColor #4A5568
    ArrowColor #2D3748
}

left to right direction
actor "Guest" as Guest
actor "Customer" as Customer
actor "Admin" as Admin

actor "Payment Gateway" as PG
actor "Email Service" as ES

Customer -up-|> Guest

rectangle "Event Ticketing System" {

    package "Public & Catalog" {
        usecase "Search & Filter Events" as UC1
        usecase "View Event Details" as UC2
        usecase "Create Account" as UC4
    }

    package "Customer Services" {
        usecase "View Attended History" as UC3
        usecase "Edit Profile" as UC5
        usecase "Add to Favourites" as UC6
        usecase "Buy Ticket" as UC7
        usecase "Download Ticket" as UC8
        usecase "Apply Promocode" as UC9
        usecase "Request Refund" as UC16
        usecase "Leave Review" as UC17
    }

    package "Admin Management" {
        usecase "Add Event" as UC10
        usecase "Edit Event" as UC11
        usecase "View Analytics" as UC12
        usecase "View Customers" as UC13
        usecase "Process Refund" as UC14
        usecase "Manage Promocodes" as UC15
        usecase "Scan Ticket" as UC18
        usecase "Cancel Event" as UC19
    }

    package "Integration Services" {
        usecase "Process Payment" as UC20
        usecase "Refund Payment" as UC21
        usecase "Send Email" as UC22
    }
}

Guest --> UC1
Guest --> UC2
Guest --> UC4

Customer --> UC3
Customer --> UC5
Customer --> UC7
Customer --> UC8
Customer --> UC16

Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14
Admin --> UC15
Admin --> UC18
Admin --> UC19

UC9  ..> UC7 : <<extend>>
UC6  ..> UC2 : <<extend>>
UC17 ..> UC3 : <<extend>>

UC7  ..> UC20 : <<include>>
UC7  ..> UC22 : <<include>>

UC14 ..> UC21 : <<include>>
UC14 ..> UC22 : <<include>>

UC19 ..> UC21 : <<include>>
UC19 ..> UC22 : <<include>>

UC20 -- PG
UC21 -- PG
UC22 -- ES

@enduml