@startuml cancel_event
autonumber
skinparam Style strictuml
skinparam SequenceMessageAlignment center

actor "Admin" as A
participant "System" as App
database "Database" as DB
actor "Payment Gateway" as PG
actor "Email Service" as ES

activate A
A -> App : cancelEvent(event_id, reason)
activate App

App -> DB : updateEventStatus(event_id, status=EventStatus.CANCELLED)
activate DB
DB --> App : listOfTickets(ticket_id, customer_email, payment_id, price)
deactivate DB

loop Для кожного купленого квитка
    App -> PG : processRefund(payment_id, amount=price)
    activate PG
    
    alt Успішне повернення коштів [refund_status == PaymentStatus.SUCCESS]
        PG --> App : refund_status = PaymentStatus.SUCCESS
        
        par Оновлення статусу та сповіщення клієнта
            App -> DB : updateTicketAndPaymentStatus(ticket_id, status=TicketStatus.REFUNDED, payment_status=PaymentStatus.REFUNDED)
            activate DB
            DB --> App : status_updated
            deactivate DB
        else
            App -> ES : sendCancellationEmail(customer_email, event_id)
            activate ES
            ES --> App : email_sent
            deactivate ES
        end

    else Помилка повернення [refund_status == PaymentStatus.FAILED]
        PG --> App : refund_status = PaymentStatus.FAILED
        App -> DB : logRefundError(ticket_id, payment_id)
        activate DB
        DB --> App : error_logged
        deactivate DB
    end
    
    deactivate PG
end

App --> A : displayNotice("Event cancelled. Refunds processed.")

deactivate App
deactivate A
@enduml