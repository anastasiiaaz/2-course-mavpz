@startuml scan_ticket
autonumber
skinparam Style strictuml
skinparam SequenceMessageAlignment center

actor "Admin" as A
participant "System" as App
database "Database" as DB

activate A
A -> App : scanTicket(qr_code)
activate App

App -> DB : getTicketStatus(ticket_id)
activate DB
DB --> App : Ticket(status, event_id)
deactivate DB

alt Сценарій 1: Квиток дійсний (status == "ACTIVE")
    App -> DB : updateTicketStatus(ticket_id, new_status="USED")
    activate DB
    deactivate DB
    App --> A : displayNotice("ACCESS GRANTED")

else Сценарій 2: Повторний прохід (status == "USED")
    App --> A : displayError("Помилка: Квиток вже використався")

else Сценарій 3: Недійсний квиток / Інша подія
    App --> A : displayError("Помилка: Квиток недійсний")
end

deactivate App
deactivate A
@enduml