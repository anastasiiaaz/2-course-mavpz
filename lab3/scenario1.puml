@startuml buy_ticket
autonumber
skinparam Style strictuml
skinparam SequenceMessageAlignment center

actor "Customer" as C
participant "System" as App
database "Database" as DB
actor "Payment Gateway" as PG
actor "Email Service" as ES

activate C
C -> App : selectSeat(event_id, seat_id)
activate App

App -> DB : reserveSeat(seat_id, expires_in=10m, status=TicketStatus.RESERVED)
activate DB
DB --> App : reservation_ok
deactivate DB

opt Використання промокоду
    C -> App : applyPromocode(code)
    App -> DB : validatePromocode(code)
    activate DB
    DB --> App : discount_percentage
    deactivate DB
end

C -> App : submitPayment(payment_details)

App -> PG : processPayment(amount)
activate PG

alt Успішна транзакція
    PG --> App : status = PaymentStatus.SUCCESS
    
    App -> DB : issueTicket(customer_id, seat_id, status=TicketStatus.ACTIVE)
    activate DB
    DB --> App : ticket_id
    deactivate DB
    
    par
        App -> ES : sendEmailNotification(customer_email, ticket_id)
        activate ES
        ES --> App : email_sent
        deactivate ES
    else
        App --> C : displaySuccessScreen(ticket_id)
    end

else Оплата не пройшла
    PG --> App : status = PaymentStatus.FAILED
    
    App -> DB : cancelReservation(seat_id)
    activate DB
    DB --> App : seat_available
    deactivate DB
    
    App --> C : displayPaymentError("Transaction declined")
end

deactivate PG
deactivate App
deactivate C
@enduml